# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 (서버 액션에서만 사용, 클라이언트 번들에 절대 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# 앱 절대 URL (초대 링크 생성용). 로컬은 http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# 약관·개인정보 처리방침에 적히는 문의처 (선택)
# 비워 두면 lib/legal.ts의 기본값을 쓴다 — 화면에 빈칸이 뜨는 일은 없다
NEXT_PUBLIC_CONTACT_EMAIL=

# 앱 푸시(APNs) — 없으면 푸시를 보내지 않는다. 키는 developer.apple.com → Keys에서 만든 .p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY=
APNS_PRODUCTION=false
# 아침 마감 알림 cron 비밀값 — Supabase Vault `cron_secret`과 같은 값
CRON_SECRET=
